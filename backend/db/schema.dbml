Project SportsMatch {
  database_type: "PostgreSQL"
  note: "Core schema: sports, sessions, participants, check-ins, dictionaries, profiles"
}

Table sports {
  key text [pk, note: "Sport key (uppercase kebab)"]
  label_zh text [not null]
  label_en text [not null]
  category text
  icon text
  sort int
  is_active boolean [not null, default: true]
}

Table countries {
  key text [pk]
  name_zh text [not null]
  name_en text [not null]
  sort int
  is_active boolean [not null, default: true]
}

Table cities {
  key text [pk]
  country_key text [not null, ref: > countries.key]
  name_zh text [not null]
  name_en text [not null]
  sort int
  is_active boolean [not null, default: true]
}

Table vibes {
  key text [pk]
  name_zh text [not null]
  name_en text [not null]
  sort int
  is_active boolean [not null, default: true]
}

Table age_ranges {
  key text [pk]
  label_zh text [not null]
  label_en text [not null]
  sort int
  is_active boolean [not null, default: true]
}

Table sessions {
  id uuid [pk]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  host_user_id uuid [not null]
  sport_key text [not null, ref: > sports.key]

  title text
  notes text

  starts_at timestamptz [not null]
  ends_at timestamptz

  place_name text [not null]
  address text
  lat double
  lng double

  checkin_radius_m int [not null, default: 100]
  checkin_open_mins_before int [not null, default: 20]
  checkin_close_mins_after int [not null, default: 20]

  min_people int [not null, default: 2]
  max_people int

  status text [not null, note: "draft | published | cancelled | completed"]
  visibility text [not null, note: "public | unlisted"]

  Indexes {
    starts_at [name: "idx_sessions_starts_at"]
    sport_key [name: "idx_sessions_sport_key"]
    status [name: "idx_sessions_status"]
  }
}

Table session_participants {
  session_id uuid [not null, ref: > sessions.id, note: "on delete cascade"]
  user_id uuid [not null]
  role text [not null, default: 'member']
  joined_at timestamptz [not null, default: `now()`]

  primary key (session_id, user_id)

  Indexes {
    user_id [name: "idx_participants_user_id"]
  }
}

Table check_ins {
  id uuid [pk, default: `uuid_generate_v4()`]
  session_id uuid [not null, ref: > sessions.id, note: "on delete cascade"]
  user_id uuid [not null]
  checked_in_at timestamptz [not null, default: `now()`]
  lat double [not null]
  lng double [not null]
  distance_m int
  status text [not null, default: "ok", note: "ok | late | outside_radius | rejected"]

  Indexes {
    session_id [name: "idx_checkins_session_id"]
    user_id [name: "idx_checkins_user_id"]
  }
}

Table users {
  id uuid [pk, note: "Supabase auth user id"]
  username text [not null, unique]
  display_name text [not null]
  legal_name text
  country_key text [ref: > countries.key]
  city_key text [ref: > cities.key]
  age_range_key text [ref: > age_ranges.key]
  vibe_key text [ref: > vibes.key]
  bio text
  avatar_url text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table user_sports {
  user_id uuid [not null, ref: > users.id, note: "on delete cascade"]
  sport_key text [not null, ref: > sports.key]
  kind text [not null, note: "FAVORITE | TRYING"]
  created_at timestamptz [not null, default: `now()`]

  primary key (user_id, sport_key, kind)
}

Table user_preferences {
  user_id uuid [pk, ref: > users.id, note: "on delete cascade"]
  preferred_time text
  sessions_per_week int
  day_slots jsonb
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}
