{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:dump": "supabase db dump --schema public > db/schema.sql",
    "db:update": "npm run db:dump",
    "openapi:lint": "npx swagger-cli validate docs/manual/openapi.yaml",
    "openapi:build": "node src/config/swagger.js",
    "openapi:update": "npm run openapi:lint && npm run openapi:build",
    "docs:update": "npm run openapi:update",
    "db:pull": "supabase db pull",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff -f update_schema",
    "clean": "docker image prune -f",
    "build-image": "docker build -t sportsmatch-api:latest .",
    "d-backend-sh": "docker exec -it sportsmatch-backend sh",
    "types:api": "openapi-typescript docs/manual/openapi.yaml -o src/types/api.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "openapi-typescript": "^7.4.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.5.0"
  }
}
